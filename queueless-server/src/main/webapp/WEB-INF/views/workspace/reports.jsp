<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><%@ taglib prefix="ql" tagdir="/WEB-INF/tags" %>
<c:if test="${dashboard.operator}"><section id="reports" class="panel"><p class="eyebrow">REAL SERVICE ACTIVITY</p><h2>Reports &amp; export</h2><div class="history-actions"><a class="button" href="${pageContext.request.contextPath}/reports?serviceId=${dashboard.serviceId}">View service report and activity matrix</a></div><p class="muted">Export service totals and observed average durations for a date range. Empty measurements remain blank.</p><form action="${pageContext.request.contextPath}/api/reports.csv" method="get" class="inline-fields"><label>From<input type="date" name="from" required></label><label>To<input type="date" name="to" required></label><button type="submit">Download CSV</button></form></section></c:if>
