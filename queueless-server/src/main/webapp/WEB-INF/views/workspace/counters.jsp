<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><%@ taglib prefix="ql" tagdir="/WEB-INF/tags" %>
<c:if test="${dashboard.operator}"><section id="counters" class="panel"><div class="section-heading"><div><p class="eyebrow">OPERATOR CONTROLS</p><h2>Service counters</h2></div></div><div class="counter-grid"><c:forEach items="${dashboard.counters}" var="counter"><article class="counter-card"><div class="section-heading"><h3><c:out value="${counter.name}" /></h3><span class="status">${counter.paused ? 'Paused' : not empty counter.visitId ? 'Busy' : empty counter.ownerId ? 'Unstaffed' : 'Ready'}</span></div><p class="muted">${empty counter.ownerId ? 'Unclaimed' : 'Operator #'}<c:if test="${not empty counter.ownerId}">${counter.ownerId}</c:if><c:if test="${not empty counter.visitId}"> · Visit #${counter.visitId}</c:if></p><div class="actions"><c:choose><c:when test="${empty counter.ownerId}"><ql:command operation="CLAIM" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" label="Claim counter" /></c:when><c:when test="${counter.ownerId == dashboard.user.id}"><c:if test="${empty counter.visitId}"><ql:command operation="NEXT" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" label="Call next" /><ql:command operation="RELEASE" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" label="Release" /></c:if><ql:command operation="PAUSE" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" label="${counter.paused ? 'Resume' : 'Pause'}"><input type="hidden" name="paused" value="${not counter.paused}"></ql:command></c:when></c:choose></div><c:forEach items="${dashboard.visits}" var="visit"><c:if test="${visit.id == counter.visitId && counter.ownerId == dashboard.user.id}"><div class="current-visit"><ql:token value="${visit.token}" visitId="${visit.id}" /><ql:status value="${visit.state}" /><div class="actions"><c:if test="${visit.state == 'CALLED'}"><ql:command operation="START" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" entityId="${visit.id}" expectedVersion="${visit.version}" label="Start service" /><ql:command operation="RECALL" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" entityId="${visit.id}" expectedVersion="${visit.version}" label="Recall" /><ql:command operation="SKIP" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" entityId="${visit.id}" expectedVersion="${visit.version}" label="Skip" /></c:if><c:if test="${visit.state == 'SERVING'}"><ql:command operation="COMPLETE" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" entityId="${visit.id}" expectedVersion="${visit.version}" label="Complete visit" /><details><summary>Abort service</summary><ql:command operation="ABORT" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" entityId="${visit.id}" expectedVersion="${visit.version}" label="Confirm abort"><label>Reason<input name="reason" maxlength="500" required></label></ql:command></details></c:if></div></div></c:if></c:forEach><c:if test="${dashboard.admin && not empty counter.ownerId}"><details><summary>Administrative takeover</summary><ql:command operation="TAKEOVER" serviceId="${dashboard.serviceId}" counterId="${counter.id}" claimVersion="${counter.claimVersion}" label="Take over counter"><label>Reason<input name="reason" maxlength="500" required></label></ql:command></details></c:if></article></c:forEach><c:if test="${empty dashboard.counters}"><p class="empty-state">No counters have been configured for this service.</p></c:if></div></section></c:if>
