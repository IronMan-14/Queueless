<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Service reports · QueueLess</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><main class="history-layout"><a class="brand" href="${pageContext.request.contextPath}/app?serviceId=${dashboard.serviceId}&amp;view=reports"><span class="brand-mark">Q</span> QueueLess</a><section class="panel"><p class="eyebrow">MEASURED SERVICE ACTIVITY</p><h1><c:out value="${dashboard.selectedService.name}" /></h1><form method="get" action="${pageContext.request.contextPath}/reports" class="inline-fields"><input type="hidden" name="serviceId" value="${dashboard.serviceId}"><label>From<input type="date" name="from" value="${from}" required></label><label>To<input type="date" name="to" value="${to}" required></label><button type="submit">Update report</button></form><p class="hint">Inclusive local dates in Asia/Kolkata. Completed, cancelled and no-show counts use finish date. Average durations include completed visits only. Appointment counts use the booked window's start date.</p><div class="table-scroll"><table><thead><tr><th>Completed</th><th>Cancelled</th><th>No-shows</th><th>Mean wait</th><th>Mean service</th><th>Appointments</th><th>Fulfilled</th></tr></thead><tbody><c:forEach items="${reports}" var="row"><tr><td>${row.completed}</td><td>${row.cancelled}</td><td>${row.noShows}</td><td><c:choose><c:when test="${empty row.averageWaitMinutes}">N/A</c:when><c:otherwise>${row.averageWaitMinutes} min</c:otherwise></c:choose></td><td><c:choose><c:when test="${empty row.averageServiceMinutes}">N/A</c:when><c:otherwise>${row.averageServiceMinutes} min</c:otherwise></c:choose></td><td>${row.appointments}</td><td>${row.fulfilledAppointments}</td></tr></c:forEach></tbody></table></div><div class="history-actions"><a class="button" href="${pageContext.request.contextPath}/api/reports.csv?from=${from}&amp;to=${to}">Export all authorized services (CSV)</a><a href="${pageContext.request.contextPath}/app?serviceId=${dashboard.serviceId}&amp;view=reports">Return to reports</a></div></section><section class="panel"><p class="eyebrow">WHEN COMPLETED VISITS BEGAN</p><h2>Activity by weekday and hour</h2><p class="hint">Each cell counts completed visits by their local service start time within the selected dates. This start-date cohort can differ from the finish-date totals above. Rows run Monday through Sunday; columns run 00:00 through 23:00.</p><div class="table-scroll"><table class="activity-matrix"><thead><tr><th>Day / hour</th><c:forEach begin="0" end="23" var="hour"><th>${hour}</th></c:forEach></tr></thead><tbody><c:forEach items="${activity.completedByStartHour}" var="row" varStatus="day"><tr><th><c:choose><c:when test="${day.index == 0}">Mon</c:when><c:when test="${day.index == 1}">Tue</c:when><c:when test="${day.index == 2}">Wed</c:when><c:when test="${day.index == 3}">Thu</c:when><c:when test="${day.index == 4}">Fri</c:when><c:when test="${day.index == 5}">Sat</c:when><c:otherwise>Sun</c:otherwise></c:choose></th><c:forEach items="${row}" var="count"><td class="${count > 0 ? 'has-activity' : ''}">${count}</td></c:forEach></tr></c:forEach></tbody></table></div></section></main></body></html>
