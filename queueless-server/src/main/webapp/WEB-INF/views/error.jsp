<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Request needs attention · QueueLess</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><main class="error-card"><a class="brand" href="${pageContext.request.contextPath}/app"><span class="brand-mark">Q</span> QueueLess</a><h1>This request needs attention.</h1><p role="alert"><c:out value="${error}" default="Please refresh and try again." /></p><c:if test="${not empty retryFields}"><form method="post" action="${pageContext.request.contextPath}/command"><c:forEach items="${retryFields}" var="field"><input type="hidden" name="<c:out value='${field.key}'/>" value="<c:out value='${field.value}'/>"></c:forEach><button type="submit">Retry the same request</button></form></c:if><a class="button primary" href="${pageContext.request.contextPath}/app">Return to your workspace</a><p class="muted">If a request timed out, retry the same request or refresh your current status before starting another operation.</p></main></body></html>
