<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="ql" tagdir="/WEB-INF/tags" %>
<section id="administration" class="panel"><p class="eyebrow">ADMINISTRATION</p><h2>Manage your services</h2><p class="muted">Configuration changes are validated by the server and recorded in the audit history.</p><div class="admin-grid">
<details><summary>Create a service</summary><ql:command operation="CREATE_SERVICE" label="Create service"><label>Service name<input name="name" maxlength="100" required></label><label>Description<textarea name="description" maxlength="500" required rows="3"></textarea></label></ql:command></details>
<c:if test="${dashboard.serviceId > 0}">
<details><summary>Service settings</summary><ql:command operation="UPDATE_SERVICE" serviceId="${dashboard.serviceId}" label="Save settings"><label>Name<input name="name" maxlength="100" value="<c:out value='${dashboard.selectedService.name}'/>" required></label><label>Description<textarea name="description" maxlength="500" required><c:out value="${dashboard.selectedService.description}" /></textarea></label><label>Queue policy<select name="policy"><option value="APPOINTMENT_AWARE" ${dashboard.selectedService.policy == 'APPOINTMENT_AWARE' ? 'selected' : ''}>Appointments with fair walk-in turns</option><option value="FIFO" ${dashboard.selectedService.policy == 'FIFO' ? 'selected' : ''}>First in, first out</option></select></label><label>Walk-in admission<select name="open"><option value="true" ${dashboard.selectedService.open ? 'selected' : ''}>Open during configured hours</option><option value="false" ${not dashboard.selectedService.open ? 'selected' : ''}>Closed to new walk-ins</option></select></label><label>Walk-in limit<input type="number" name="walkInLimit" min="1" max="10000" value="${dashboard.selectedService.walkInLimit}" required></label><label>Planned counter minutes per day<input type="number" name="plannedMinutes" min="0" max="100000" value="${dashboard.selectedService.plannedMinutes}" required></label><label>Reference minutes per visit<input type="number" name="referenceMinutes" min="1" max="480" value="${dashboard.selectedService.referenceMinutes}" required></label></ql:command></details>
<details><summary>Working hours</summary><ql:command operation="HOURS" serviceId="${dashboard.serviceId}" label="Save working hours"><label>Day<select name="day"><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option><option value="7">Sunday</option></select></label><label>Opens (Asia/Kolkata)<input type="time" name="opens" required></label><label>Closes (Asia/Kolkata)<input type="time" name="closes" required></label><p class="hint">One daily interval. Existing visits remain available to resolve.</p></ql:command></details>
<details><summary>Close a date</summary><ql:command operation="CLOSE_DATE" serviceId="${dashboard.serviceId}" label="Add closure"><label>Date<input type="date" name="date" required></label><label>Reason<input name="reason" maxlength="500" required></label></ql:command></details>
<details><summary>Add a counter</summary><ql:command operation="CREATE_COUNTER" serviceId="${dashboard.serviceId}" label="Create counter"><label>Counter name<input name="name" maxlength="100" required></label></ql:command></details>
<details><summary>Assign staff</summary><ql:command operation="ASSIGN_STAFF" serviceId="${dashboard.serviceId}" label="Assign to this service"><label>Account<select name="userId" required><c:forEach items="${members}" var="member"><c:if test="${member.active}"><option value="${member.id}">#${member.id} · <c:out value="${member.name}" /> · <c:out value="${member.email}" /> (<c:out value="${member.role}" />)</option></c:if></c:forEach></select></label></ql:command></details>
<details><summary>Create an appointment window</summary><ql:command operation="CREATE_SLOT" serviceId="${dashboard.serviceId}" label="Create window"><label>Starts (Asia/Kolkata)<input type="datetime-local" name="startsAt" data-india-time required></label><label>Ends (Asia/Kolkata)<input type="datetime-local" name="endsAt" data-india-time required></label><label>Reservation capacity<input type="number" name="capacity" min="1" max="10000" required></label><p class="hint">This is the reservation limit. Counter availability is managed separately.</p><label class="checkbox-label"><input type="checkbox" name="acknowledgeShortfall" value="true"> Publish even if reservations exceed the advisory staffing plan</label></ql:command></details>
<details><summary>Change a window's capacity</summary><ql:command operation="UPDATE_SLOT" serviceId="${dashboard.serviceId}" label="Update capacity"><label>Window<select name="slotId" required><c:forEach items="${dashboard.slots}" var="slot"><option value="${slot.id}">#${slot.id} · <c:out value="${slot.startsAt}" /></option></c:forEach></select></label><label>New capacity<input type="number" name="capacity" min="1" max="10000" required></label><p class="hint">Capacity cannot fall below retained reservations.</p></ql:command></details>
<details><summary>Remove staff assignment</summary><ql:command operation="UNASSIGN_STAFF" serviceId="${dashboard.serviceId}" label="Remove assignment"><label>Account<select name="userId" required><c:forEach items="${members}" var="member"><option value="${member.id}">#${member.id} · <c:out value="${member.name}" /> (<c:out value="${member.role}" />)</option></c:forEach></select></label><p class="hint">An occupied counter must be resolved before its operator can be unassigned.</p></ql:command></details>
<details><summary>Reopen a closed date</summary><ql:command operation="OPEN_DATE" serviceId="${dashboard.serviceId}" label="Remove date closure"><label>Date<select name="date" required><c:forEach items="${closures}" var="closure"><option value="<c:out value='${closure.date}'/>"><c:out value="${closure.date}" /></option></c:forEach></select></label></ql:command></details>
</c:if></div><details><summary>Registered accounts (latest 500)</summary><div class="table-scroll"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Account</th></tr></thead><tbody><c:forEach items="${members}" var="member"><tr><td>${member.id}</td><td><c:out value="${member.name}" /></td><td><c:out value="${member.email}" /></td><td><c:out value="${member.role}" /></td><td>${member.active ? 'Active' : 'Inactive'}</td></tr></c:forEach></tbody></table></div></details><c:if test="${dashboard.serviceId > 0}"><details><summary>Service audit history (latest 100)</summary><div class="table-scroll"><table><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Record</th><th>Detail</th></tr></thead><tbody><c:forEach items="${audit}" var="event"><tr><td><time data-instant="<c:out value='${event.createdAt}'/>"><c:out value="${event.createdAt}" /></time></td><td>${empty event.actorId ? 'System' : event.actorId}</td><td><c:out value="${event.action}" /></td><td>${event.entityId}</td><td><c:out value="${event.detail}" /></td></tr></c:forEach><c:if test="${empty audit}"><tr><td colspan="5" class="empty-state">No administrative changes recorded for this service.</td></tr></c:if></tbody></table></div></details></c:if></section>

