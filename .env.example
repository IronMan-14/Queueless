# Copy to .env and replace every placeholder before starting Docker Compose.
QUEUELESS_DB_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
# Online deployment: a DNS name pointing at your server.
QUEUELESS_DOMAIN=queue.example.com
QUEUELESS_PUBLIC_ORIGIN=http://localhost:8080
